rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Survey links are public, so respondents may upload attachments without signing in.
    // Limit uploads to supported document/image formats and 10 MB per file.
    match /survey-responses/{ownerId}/{surveyId}/{responseId}/{fileName} {
      // Only the survey owner can download files from the results dashboard.
      allow read: if request.auth != null && request.auth.uid == ownerId;
      // Storage rules expose read/write (not separate create/update/delete methods).
      // Permit only a new object so a public respondent cannot overwrite or delete files.
      allow write: if resource == null
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/(jpeg|png|gif|webp)|application/msword|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)|application/vnd\\.ms-(excel|powerpoint)'
        );
    }
  }
}
